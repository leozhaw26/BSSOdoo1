<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Bestellung" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="17.0.0">
  <bpmn:collaboration id="Collab_Bestellung">
    <bpmn:participant id="Pool_Kunde" name="Kunde (Online-Besucher)" processRef="Process_Kunde" />
    <bpmn:participant id="Pool_MyOffice2" name="MyOffice Inc." processRef="Process_MyOffice" />
    <bpmn:messageFlow id="Msg1" name="Bestellung + Zahlung" sourceRef="K5" targetRef="MS" />
    <bpmn:messageFlow id="Msg2" name="Bestätigung" sourceRef="M3" targetRef="KC1" />
    <bpmn:messageFlow id="Msg3" name="Lieferung" sourceRef="L1" targetRef="KC2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Kunde" isExecutable="false">
    <bpmn:startEvent id="KS" name="Bedarf an Bürostuhl festgestellt">
      <bpmn:outgoing>KF1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="K1" name="Webshop besuchen">
      <bpmn:incoming>KF1</bpmn:incoming>
      <bpmn:outgoing>KF2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="K2" name="Farbe und Material wählen">
      <bpmn:incoming>KF2</bpmn:incoming>
      <bpmn:outgoing>KF3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="K3" name="Bürostuhl in Warenkorb legen">
      <bpmn:incoming>KF3</bpmn:incoming>
      <bpmn:outgoing>KF4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="KG1" name="Garantie gewünscht?">
      <bpmn:incoming>KF4</bpmn:incoming>
      <bpmn:outgoing>KF5</bpmn:outgoing>
      <bpmn:outgoing>KF6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="K4" name="Garantie (3 Jahre) hinzufügen">
      <bpmn:incoming>KF5</bpmn:incoming>
      <bpmn:outgoing>KF7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="KG2" name="">
      <bpmn:incoming>KF6</bpmn:incoming>
      <bpmn:incoming>KF7</bpmn:incoming>
      <bpmn:outgoing>KF8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="K5" name="Bestellung aufgeben und bezahlen">
      <bpmn:incoming>KF8</bpmn:incoming>
      <bpmn:outgoing>KF9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="KC1" name="Bestellbestätigung erhalten">
      <bpmn:incoming>KF9</bpmn:incoming>
      <bpmn:outgoing>KF10</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="KC2" name="Bürostuhl erhalten">
      <bpmn:incoming>KF10</bpmn:incoming>
      <bpmn:outgoing>KF11</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="KE" name="Bedarf gedeckt">
      <bpmn:incoming>KF11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="KF1" name="" sourceRef="KS" targetRef="K1" />
    <bpmn:sequenceFlow id="KF2" name="" sourceRef="K1" targetRef="K2" />
    <bpmn:sequenceFlow id="KF3" name="" sourceRef="K2" targetRef="K3" />
    <bpmn:sequenceFlow id="KF4" name="" sourceRef="K3" targetRef="KG1" />
    <bpmn:sequenceFlow id="KF5" name="ja" sourceRef="KG1" targetRef="K4" />
    <bpmn:sequenceFlow id="KF6" name="nein" sourceRef="KG1" targetRef="KG2" />
    <bpmn:sequenceFlow id="KF7" name="" sourceRef="K4" targetRef="KG2" />
    <bpmn:sequenceFlow id="KF8" name="" sourceRef="KG2" targetRef="K5" />
    <bpmn:sequenceFlow id="KF9" name="" sourceRef="K5" targetRef="KC1" />
    <bpmn:sequenceFlow id="KF10" name="" sourceRef="KC1" targetRef="KC2" />
    <bpmn:sequenceFlow id="KF11" name="" sourceRef="KC2" targetRef="KE" />
  </bpmn:process>
  <bpmn:process id="Process_MyOffice" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_MyOffice">
      <bpmn:lane id="Lane_Shop" name="Webshop (Odoo)">
        <bpmn:flowNodeRef>MS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Lager" name="Lager">
        <bpmn:flowNodeRef>MP1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MP2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ME</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Buha" name="Buchhaltung">
        <bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="MS" name="Online-Bestellung eingegangen">
      <bpmn:outgoing>MF1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="M1" name="Zahlung prüfen">
      <bpmn:incoming>MF1</bpmn:incoming>
      <bpmn:outgoing>MF2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="M2" name="Verkaufsauftrag bestätigen">
      <bpmn:incoming>MF2</bpmn:incoming>
      <bpmn:outgoing>MF3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="M3" name="Bestätigung per E-Mail senden">
      <bpmn:incoming>MF3</bpmn:incoming>
      <bpmn:outgoing>MF4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="MP1" name="">
      <bpmn:incoming>MF4</bpmn:incoming>
      <bpmn:outgoing>MF5</bpmn:outgoing>
      <bpmn:outgoing>MF6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="L1" name="Lieferung versenden">
      <bpmn:incoming>MF5</bpmn:incoming>
      <bpmn:outgoing>MF7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B1" name="Rechnung erstellen und buchen">
      <bpmn:incoming>MF6</bpmn:incoming>
      <bpmn:outgoing>MF8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="MP2" name="">
      <bpmn:incoming>MF7</bpmn:incoming>
      <bpmn:incoming>MF8</bpmn:incoming>
      <bpmn:outgoing>MF9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="ME" name="Bestellung abgewickelt">
      <bpmn:incoming>MF9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="MF1" name="" sourceRef="MS" targetRef="M1" />
    <bpmn:sequenceFlow id="MF2" name="" sourceRef="M1" targetRef="M2" />
    <bpmn:sequenceFlow id="MF3" name="" sourceRef="M2" targetRef="M3" />
    <bpmn:sequenceFlow id="MF4" name="" sourceRef="M3" targetRef="MP1" />
    <bpmn:sequenceFlow id="MF5" name="" sourceRef="MP1" targetRef="L1" />
    <bpmn:sequenceFlow id="MF6" name="" sourceRef="MP1" targetRef="B1" />
    <bpmn:sequenceFlow id="MF7" name="" sourceRef="L1" targetRef="MP2" />
    <bpmn:sequenceFlow id="MF8" name="" sourceRef="B1" targetRef="MP2" />
    <bpmn:sequenceFlow id="MF9" name="" sourceRef="MP2" targetRef="ME" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Bestellung">
    <bpmndi:BPMNPlane id="Plane_Bestellung" bpmnElement="Collab_Bestellung">
      <bpmndi:BPMNShape id="Pool_Kunde_di" bpmnElement="Pool_Kunde" isHorizontal="true"><dc:Bounds x="150" y="60" width="1780" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_MyOffice2_di" bpmnElement="Pool_MyOffice2" isHorizontal="true"><dc:Bounds x="150" y="320" width="1780" height="390" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Shop_di" bpmnElement="Lane_Shop" isHorizontal="true"><dc:Bounds x="180" y="320" width="1750" height="130" /></bpmndi:BPMNShape>
