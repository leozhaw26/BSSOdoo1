      <bpmndi:BPMNShape id="L1_di" bpmnElement="L1"><dc:Bounds x="1600" y="475" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B1_di" bpmnElement="B1"><dc:Bounds x="1600" y="605" width="100" height="80" /></bpmndi:BPMNShape>
