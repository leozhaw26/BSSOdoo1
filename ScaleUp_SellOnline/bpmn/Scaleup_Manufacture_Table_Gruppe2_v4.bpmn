    <bpmn:participant id="P_MyO" name="Tischfertigung MyOffice Inc." processRef="Proc_MyO" />
    <bpmn:messageFlow id="m1" sourceRef="E1" targetRef="S_Start" />
    <bpmn:messageFlow id="m2" sourceRef="S_T2" targetRef="L0" />
