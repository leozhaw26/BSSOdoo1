  <bpmn:process id="Proc_Lief" isExecutable="false">
    <bpmn:laneSet id="LS_P_Lief">
      <bpmn:lane id="L_Verkauf" name="Verkauf">
        <bpmn:flowNodeRef>S_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Versand" name="Versand">
        <bpmn:flowNodeRef>S_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_Start" name="Bestellung erhalten">
      <bpmn:outgoing>s1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_S_Start" />
    </bpmn:startEvent>
    <bpmn:task id="S_T1" name="Bestellung bestätigen">
      <bpmn:incoming>s1</bpmn:incoming>
      <bpmn:outgoing>s2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_T2" name="Rohmaterial liefern">
      <bpmn:incoming>s2</bpmn:incoming>
      <bpmn:outgoing>s3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="S_End" name="Rohmaterial geliefert">
      <bpmn:incoming>s3</bpmn:incoming>
    </bpmn:endEvent>
